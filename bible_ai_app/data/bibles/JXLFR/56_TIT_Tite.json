            "francais": "dans la-foi."
          },
          {
            "grec": "ἡ χάρις",
            "francais": "La grâce soit"
          },
          {
            "grec": "μετὰ ὑμῶν πάντων",
            "francais": "avec vous tous."
          }
        ]
      }
    }
  }
